{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PCakes303/agent-skill-library/blob/main/schemas/skill-workflow.schema.json",
  "title": "Agent Skill Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_version",
    "skill_id",
    "skill_version",
    "steps"
  ],
  "properties": {
    "workflow_version": {
      "const": "1.0"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{2,127}$"
    },
    "skill_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "policy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "action": {
            "enum": [
              "tool.invoke",
              "agent.delegate",
              "human.approval",
              "data.transform"
            ]
          },
          "adapter_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "capability": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          },
          "prompt": {
            "type": "string",
            "maxLength": 2000
          },
          "inputs": {
            "type": "object",
            "maxProperties": 64
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "resource",
              "scopes"
            ],
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "resource": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "scopes": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        }
      }
    }
  }
}
